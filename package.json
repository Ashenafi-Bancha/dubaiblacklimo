{
  "name": "luxury-chauffeur-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "White-label luxury chauffeur and limousine booking platform",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @app/client dev",
    "build": "pnpm --filter @app/client build",
    "preview": "pnpm --filter @app/client preview",
    "images": "node scripts/optimize-images.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
